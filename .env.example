# Optional. Set in your shell; the application does not auto-load .env.
# Relative paths are resolved from the project root.
AGENT_PENTEST_RUNTIME=runtime
# Optional project root; precedence: this variable, valid current directory, package source.
# AGENT_PENTEST_ROOT=C:/path/to/ai-agent-pentest
# Deterministic offline default. "chat" requires an explicitly injected ChatModel;
# no provider or paid API is created automatically.
AGENT_PENTEST_EMAIL_BACKEND=rule
# No API keys or credentials are needed for SIMULATION.
# Live runtime/worker: set the same private token in both shells (at least 16 chars).
# AGENT_PENTEST_RUNTIME_TOKEN=
# Provider key is needed only in the live target runtime shell.
# AGENT_PENTEST_LLM_API_KEY=
# Optional role LLM key is separate and needed only in the worker shell.
# AGENT_PENTEST_ROLE_API_KEY=

